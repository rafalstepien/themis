# Local testing environment - GitLab CI variables simulator
# Copy this file to .env.test and fill in your actual values for local testing
# DO NOT commit .env.test to version control

# GitLab API token (obtain from GitLab settings)
# For local testing, use a personal access token from your GitLab instance
GITLAB_API_TOKEN="glpat-xxxxxxxxxxxxxxxx"  # scope: api
LLM_API_TOKEN="openai-..."
JIRA_API_TOKEN="jira-..."

# GitLab instance URL (if using a self-hosted GitLab)
GITLAB_URL="https://gitlab.com"

# Merge Request details (dummy values for testing)
CI_MERGE_REQUEST_IID="123"
CI_MERGE_REQUEST_SOURCE_BRANCH="feature/my-change"
CI_MERGE_REQUEST_TARGET_BRANCH="main"
CI_PROJECT_ID="456"
CI_PROJECT_NAME="my-project"
CI_PROJECT_NAMESPACE="my-namespace"

# Optional: GitLab server URL for API calls
CI_SERVER_HOST="gitlab.com"

# Root of the consumer repo under review — anchors all .themis-ai/ reads
# (config, rules, architecture), exactly as GitLab sets CI_PROJECT_DIR on CI.
# test_local.sh defaults this to the sibling themis-example checkout; override
# by exporting TARGET_REPO=/path/to/repo before running, or set it here.
# CI_PROJECT_DIR="/Users/you/repos/sandbox/themis-repos/themis-example"
